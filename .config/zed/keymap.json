// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "super-p": "file_finder::Toggle",
      "ctrl-t": "task::Spawn",
      "super-b": "workspace::ToggleLeftDock",
      "super-r": "workspace::ToggleRightDock",
      "super-w": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle",
      "super-z": "workspace::ToggleZoom",
      "super-p": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-j": "workspace::ToggleBottomDock",
      "ctrl-b": "workspace::ToggleLeftDock",
      "alt-b alt-b": "editor::ToggleBreakpoint",
      "alt-b alt-d": "debugger::ToggleDataBreakpoint",
      "alt-b alt-l": "editor::EditLogBreakpoint",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "alt-f": "workspace::ToggleZoom",
      // "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
      // "ctrl-t": null,
    },
  },
  {
    "bindings": {
      "ctrl-g G": "git_graph::Open",
      "ctrl-g u": "git::ViewUnstagedChanges",
      "ctrl-g s": "editor::ToggleSplitDiff",
      "ctrl-g D": [
        "task::Spawn",
        { "task_name": "gh Dash", "reveal_target": "center" },
      ],
      "ctrl-g ctrl-o": "editor::OpenPermalinkToLine",
      "ctrl-g o": "editor::CopyPermalinkToLine",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-alt-shift-w": "workspace::CloseInactiveTabsAndPanes"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-g ctrl-w": "git::Worktree"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-shift-w": "git::Worktree"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-g ctrl-b": "git::Branch"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-shift-b": "git::Branch"
    }
  }
]
