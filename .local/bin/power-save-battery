#!/bin/bash
# Temporary Power Saving Script
# All changes are non-persistent and will be reset on reboot

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default settings (can be overridden by arguments)
DO_DOCKER=true
DO_BLUETOOTH=false
DO_WIFI=false
DO_USB=true
DO_CPU=true
DO_PCI=true
DO_SATA=true
DO_VM=true

# Parse command line arguments
show_help() {
    cat << EOF
${GREEN}Power Save Battery Script${NC}
Temporary power saving measures (reset on reboot)

${YELLOW}Usage:${NC}
  $0 [OPTIONS]

${YELLOW}Preset Modes:${NC}
  --all               Enable all optimizations (including BT/WiFi)
  --minimal           Only stop Docker/K8s
  --work              Default mode (skip BT/WiFi, enable everything else)

${YELLOW}Individual Options:${NC}
  --docker            Stop Docker/Kubernetes (~6W)
  --no-docker         Keep Docker/K8s running

  --bluetooth         Disable Bluetooth (~1W)
  --no-bluetooth      Keep Bluetooth enabled

  --wifi              Enable WiFi power save (~0.5-1W)
  --no-wifi           Keep WiFi at normal power

  --usb               Enable USB autosuspend (~0.5W)
  --no-usb            Skip USB autosuspend

  --cpu               Aggressive CPU power policy (~1W)
  --no-cpu            Skip CPU optimizations

  --pci               Enable PCI runtime PM
  --no-pci            Skip PCI power management

  --sata              SATA link power management
  --no-sata           Skip SATA optimizations

  --vm                Optimize VM writeback
  --no-vm             Skip VM optimizations

${YELLOW}Examples:${NC}
  $0                          # Default: everything except BT/WiFi
  $0 --all                    # Enable all optimizations
  $0 --minimal                # Only stop Docker
  $0 --docker --bluetooth     # Stop Docker and disable Bluetooth
  $0 --all --no-cpu           # Everything except CPU optimizations
  $0 --bluetooth --wifi       # Only disable BT and enable WiFi power save

${YELLOW}Help:${NC}
  -h, --help          Show this help message

EOF
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        --all)
            DO_DOCKER=true
            DO_BLUETOOTH=true
            DO_WIFI=true
            DO_USB=true
            DO_CPU=true
            DO_PCI=true
            DO_SATA=true
            DO_VM=true
            shift
            ;;
        --minimal)
            DO_DOCKER=true
            DO_BLUETOOTH=false
            DO_WIFI=false
            DO_USB=false
            DO_CPU=false
            DO_PCI=false
            DO_SATA=false
            DO_VM=false
            shift
            ;;
        --work)
            DO_DOCKER=true
            DO_BLUETOOTH=false
            DO_WIFI=false
            DO_USB=true
            DO_CPU=true
            DO_PCI=true
            DO_SATA=true
            DO_VM=true
            shift
            ;;
        --docker)
            DO_DOCKER=true
            shift
            ;;
        --no-docker)
            DO_DOCKER=false
            shift
            ;;
        --bluetooth)
            DO_BLUETOOTH=true
            shift
            ;;
        --no-bluetooth)
            DO_BLUETOOTH=false
            shift
            ;;
        --wifi)
            DO_WIFI=true
            shift
            ;;
        --no-wifi)
            DO_WIFI=false
            shift
            ;;
        --usb)
            DO_USB=true
            shift
            ;;
        --no-usb)
            DO_USB=false
            shift
            ;;
        --cpu)
            DO_CPU=true
            shift
            ;;
        --no-cpu)
            DO_CPU=false
            shift
            ;;
        --pci)
            DO_PCI=true
            shift
            ;;
        --no-pci)
            DO_PCI=false
            shift
            ;;
        --sata)
            DO_SATA=true
            shift
            ;;
        --no-sata)
            DO_SATA=false
            shift
            ;;
        --vm)
            DO_VM=true
            shift
            ;;
        --no-vm)
            DO_VM=false
            shift
            ;;
        *)
            echo -e "${RED}Error: Unknown option: $1${NC}"
            echo "Run '$0 --help' for usage information"
            exit 1
            ;;
    esac
done

echo -e "${GREEN}=== Applying Temporary Power Saving Measures ===${NC}"
echo "All changes will be reset on reboot"
echo ""

# Track power saved
POWER_SAVED=0

# 1. Stop Docker/Kubernetes
if [ "$DO_DOCKER" = true ]; then
    echo -e "${YELLOW}[1/8]${NC} Stopping Docker and Kubernetes..."
    if systemctl is-active --quiet docker 2>/dev/null || systemctl is-active --quiet containerd 2>/dev/null; then
        # List kind clusters for user info
        if command -v kind &> /dev/null; then
            KIND_CLUSTERS=$(kind get clusters 2>/dev/null | wc -l)
            if [ "$KIND_CLUSTERS" -gt 0 ]; then
                echo "  → Found $KIND_CLUSTERS kind cluster(s) - will be preserved"
            fi
        fi

        # Stop containers
        echo "  → Stopping containers..."
        docker stop $(docker ps -q) 2>/dev/null || true

        # Mask services to prevent auto-restart (temporary)
        echo "  → Masking services to prevent auto-restart..."
        sudo systemctl mask kubelet 2>/dev/null || true
        sudo systemctl mask docker 2>/dev/null || true
        sudo systemctl mask containerd 2>/dev/null || true

        # Stop services
        sudo systemctl stop kubelet 2>/dev/null || true
        sudo systemctl stop docker 2>/dev/null || true
        sudo systemctl stop containerd 2>/dev/null || true

        echo "  ✓ Docker/K8s stopped and masked (won't auto-restart)"
        echo "  ✓ kind clusters preserved (will restart with Docker)"
        POWER_SAVED=$((POWER_SAVED + 6))
    else
        echo "  ⊘ Docker already stopped"
    fi
else
    echo -e "${YELLOW}[1/8]${NC} Docker/Kubernetes..."
    echo "  ⊘ Skipped (--no-docker)"
fi

# 2. Bluetooth
if [ "$DO_BLUETOOTH" = true ]; then
    echo -e "${YELLOW}[2/8]${NC} Disabling Bluetooth..."
    if rfkill list bluetooth | grep -q "Soft blocked: no" 2>/dev/null; then
        sudo systemctl stop bluetooth 2>/dev/null || true
        rfkill block bluetooth
        echo "  ✓ Bluetooth disabled"
        POWER_SAVED=$((POWER_SAVED + 1))
    else
        echo "  ⊘ Bluetooth already disabled"
    fi
else
    echo -e "${YELLOW}[2/8]${NC} Bluetooth..."
    echo "  ⊘ Skipped - keeping Bluetooth enabled"
fi

# 3. WiFi
if [ "$DO_WIFI" = true ]; then
    echo -e "${YELLOW}[3/8]${NC} Enabling WiFi power save..."
    WIFI_DEV=$(iw dev | grep Interface | awk '{print $2}' | head -n1)
    if [ -n "$WIFI_DEV" ]; then
        sudo iw dev "$WIFI_DEV" set power_save on 2>/dev/null || true
        echo "  ✓ WiFi power save enabled on $WIFI_DEV"
        POWER_SAVED=$((POWER_SAVED + 1))
    else
        echo "  ⊘ No WiFi device found"
    fi
else
    echo -e "${YELLOW}[3/8]${NC} WiFi..."
    echo "  ⊘ Skipped - keeping WiFi at normal power"
fi

# 4. USB autosuspend
if [ "$DO_USB" = true ]; then
    echo -e "${YELLOW}[4/8]${NC} Enabling USB autosuspend..."
    for device in /sys/bus/usb/devices/*/power/control; do
        if [ -f "$device" ]; then
            echo 'auto' | sudo tee "$device" > /dev/null 2>&1 || true
        fi
    done
    echo "  ✓ USB autosuspend enabled"
else
    echo -e "${YELLOW}[4/8]${NC} USB autosuspend..."
    echo "  ⊘ Skipped (--no-usb)"
fi

# 5. CPU power policy
if [ "$DO_CPU" = true ]; then
    echo -e "${YELLOW}[5/8]${NC} Setting CPU to power-saving mode..."
    for policy in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        if [ -f "$policy" ]; then
            echo 'power' | sudo tee "$policy" > /dev/null 2>&1 || true
        fi
    done
    # Disable CPU turbo boost
    if [ -f /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
        echo '1' | sudo tee /sys/devices/system/cpu/intel_pstate/no_turbo > /dev/null 2>&1 || true
        echo "  ✓ CPU power policy set, turbo boost disabled"
    else
        echo "  ✓ CPU power policy set"
    fi
    POWER_SAVED=$((POWER_SAVED + 1))
else
    echo -e "${YELLOW}[5/8]${NC} CPU power policy..."
    echo "  ⊘ Skipped (--no-cpu)"
fi

# 6. PCI runtime PM
if [ "$DO_PCI" = true ]; then
    echo -e "${YELLOW}[6/8]${NC} Enabling runtime PM for PCI devices..."
    for device in /sys/bus/pci/devices/*/power/control; do
        if [ -f "$device" ]; then
            echo 'auto' | sudo tee "$device" > /dev/null 2>&1 || true
        fi
    done
    echo "  ✓ Runtime PM enabled for PCI devices"
else
    echo -e "${YELLOW}[6/8]${NC} PCI runtime PM..."
    echo "  ⊘ Skipped (--no-pci)"
fi

# 7. SATA power management
if [ "$DO_SATA" = true ]; then
    echo -e "${YELLOW}[7/8]${NC} Enabling aggressive SATA power management..."
    for host in /sys/class/scsi_host/*/link_power_management_policy; do
        if [ -f "$host" ]; then
            echo 'min_power' | sudo tee "$host" > /dev/null 2>&1 || true
        fi
    done
    echo "  ✓ SATA link power management set to min_power"
else
    echo -e "${YELLOW}[7/8]${NC} SATA power management..."
    echo "  ⊘ Skipped (--no-sata)"
fi

# 8. VM writeback
if [ "$DO_VM" = true ]; then
    echo -e "${YELLOW}[8/8]${NC} Optimizing VM writeback..."
    sudo sysctl -w vm.dirty_writeback_centisecs=1500 > /dev/null 2>&1 || true
    echo "  ✓ VM writeback optimized"
else
    echo -e "${YELLOW}[8/8]${NC} VM writeback..."
    echo "  ⊘ Skipped (--no-vm)"
fi

echo ""
echo -e "${GREEN}=== Power Saving Applied ===${NC}"
echo ""

# Show current status
echo "=== Current Battery Status ==="
if command -v upower &> /dev/null; then
    BAT=$(upower -e | grep battery | head -n1)
    if [ -n "$BAT" ]; then
        upower -i "$BAT" | grep -E "(state|energy-rate|percentage|time to)"
    fi
fi

echo ""
echo -e "${GREEN}Estimated power reduction: ~${POWER_SAVED}W${NC}"
if [ $POWER_SAVED -gt 0 ]; then
    echo "Expected battery life improvement: 2-3x"
fi
echo ""
echo -e "${YELLOW}Note:${NC} All changes are temporary and will be reset on reboot"
if [ "$DO_DOCKER" = true ]; then
    echo "To restore Docker/K8s now, run: ./restore-services.sh"
fi
