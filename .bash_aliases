alias cat='bat -p'
alias xc='wl-copy'
alias xo='wl-paste'
alias lst='ls -t | head'
alias ll='ls -alFh'

alias ra='ranger'

alias npm='pnpm'

alias usu='uniq | sort | uniq'
alias usuc='uniq | sort | uniq | wc -l'
alias csvlens='csvlens -d auto'

alias batcat=bat

alias se='synchro eval'
alias ss='synchro show'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
